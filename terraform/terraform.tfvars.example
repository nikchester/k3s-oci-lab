# Use the tenancy home region and an existing compartment.
region             = "eu-frankfurt-1"
oci_config_profile = "DEFAULT"
compartment_ocid   = "REPLACE_WITH_COMPARTMENT_OCID"

# Pick an AD in eu-frankfurt-1; try another AD if A1 host capacity is exhausted.
availability_domain = "XXXX:EU-FRANKFURT-1-AD-1"
# Pin a Canonical-Ubuntu-24.04-aarch64 image (not Minimal, not amd64).
image_ocid          = "REPLACE_WITH_ARM64_IMAGE_OCID"

# Operator-specific settings.
ssh_public_key_path = "~/.ssh/YOUR_KEY.pub"
ssh_source_cidr     = "REPLACE_WITH_YOUR_PUBLIC_IPV4/32"
